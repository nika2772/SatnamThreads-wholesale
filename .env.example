# Copy this file to ".env" and edit as needed. All values are optional.

# Port the site runs on
PORT=3000

# Public URL — used for canonical tags, sitemap and structured data.
# Set this to your real domain before going live.
SITE_URL=http://localhost:3000

# Password for the admin account created on first run.
# Only used the very first time the database is built.
ADMIN_PASSWORD=satnam@2026

# Set to "production" to enable template caching
NODE_ENV=development
