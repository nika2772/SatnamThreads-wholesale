<%- include('admin/partials-top',{title:'Settings',nav:'set'}) %>
<div class="topbar"><div><h1>Settings</h1><p class="muted" style="margin:0">Store details, shipping rules and payments</p></div></div>
<form method="post" action="/admin/settings" enctype="multipart/form-data">
<div class="grid g2" style="align-items:start">
  <div>
    <div class="card card-pad">
      <h2>Business details</h2>
      <div class="field"><label>Store name</label><input class="input" name="site_name" value="<%= S.site_name %>"></div>
      <div class="field"><label>Tagline</label><input class="input" name="tagline" value="<%= S.tagline %>"></div>
      <div class="field"><label>Announcement bar</label><input class="input" name="announcement" value="<%= S.announcement %>">
        <div class="hint">The strip at the very top of every page.</div></div>
      <div class="row">
        <div class="field"><label>Phone</label><input class="input" name="phone" value="<%= S.phone %>"></div>
        <div class="field"><label>WhatsApp number</label><input class="input" name="whatsapp" value="<%= S.whatsapp %>">
          <div class="hint">Digits only, with country code: 918459455595</div></div>
      </div>
      <div class="field"><label>Email</label><input class="input" type="email" name="email" value="<%= S.email %>"></div>
      <div class="field"><label>Address</label><input class="input" name="address" value="<%= S.address %>"></div>
      <div class="row">
        <div class="field"><label>Working hours</label><input class="input" name="hours" value="<%= S.hours %>"></div>
        <div class="field"><label>GSTIN</label><input class="input" name="gstin" value="<%= S.gstin %>"></div>
      </div>
    </div>
    <div class="card card-pad" style="margin-top:16px">
      <h2>Store Branding</h2>
      <div class="field"><label>Site Logo</label><input class="input" type="file" name="site_logo" accept="image/*">
        <div class="hint">Upload a transparent PNG or SVG logo. Current: <%= S.site_logo || '/static/img/brand/logo.jpg' %></div></div>
      <div class="row">
        <div class="field"><label>Primary Color (Navy)</label><input class="input" type="color" name="theme_color_primary" value="<%= S.theme_color_primary || '#1D3159' %>" style="height:40px;padding:4px"></div>
        <div class="field"><label>Secondary Color (Gold)</label><input class="input" type="color" name="theme_color_secondary" value="<%= S.theme_color_secondary || '#B27A22' %>" style="height:40px;padding:4px"></div>
      </div>
    </div>
    <div class="card card-pad" style="margin-top:16px">
      <h2>Homepage Content</h2>
      <div class="field"><label>Hero Headline</label><textarea class="input" name="home_hero_title" rows="2"><%= S.home_hero_title || "The garment accessories your line runs on — in stock, in Delhi." %></textarea></div>
      <div class="field"><label>Hero Subtext</label><textarea class="input" name="home_hero_sub" rows="3"><%= S.home_hero_sub || "Tagging guns and barbs, tags and labels, pins, threading thread and packing consumables. Same-day dispatch on orders placed before 2 PM. Register an account to send bulk enquiries." %></textarea></div>
      <div class="field"><label>Hero Kicker</label><input class="input" name="home_hero_kicker" value="<%= S.home_hero_kicker || "Wholesale since 1993" %>"></div>
      <div class="row">
        <div class="field"><label>Stat 1 Title</label><input class="input" name="home_stat1_title" value="<%= S.home_stat1_title || "33 yrs" %>"></div>
        <div class="field"><label>Stat 1 Text</label><input class="input" name="home_stat1_text" value="<%= S.home_stat1_text || "Supplying Delhi's garment trade" %>"></div>
      </div>
      <div class="row">
        <div class="field"><label>Stat 2 Title</label><input class="input" name="home_stat2_title" value="<%= S.home_stat2_title || "2,000+" %>"></div>
        <div class="field"><label>Stat 2 Text</label><input class="input" name="home_stat2_text" value="<%= S.home_stat2_text || "Exporters, salons & retailers served" %>"></div>
      </div>
    </div>
  </div>
  <div>
    <div class="card card-pad">
      <h2>Menus & Social Links</h2>
      <div class="field"><label>Header Links (Format: Name | /url-path)</label><textarea class="input" name="menu_header" rows="4" placeholder="About | /pages/about-us"><%= S.menu_header %></textarea></div>
      <div class="field"><label>Footer Company Links</label><textarea class="input" name="menu_footer_company" rows="4" placeholder="Terms | /pages/terms-conditions"><%= S.menu_footer_company %></textarea></div>
      <div class="field"><label>Instagram URL</label><input class="input" name="social_instagram" value="<%= S.social_instagram %>"></div>
      <div class="field"><label>Facebook URL</label><input class="input" name="social_facebook" value="<%= S.social_facebook %>"></div>
      <div class="field"><label>LinkedIn URL</label><input class="input" name="social_linkedin" value="<%= S.social_linkedin %>"></div>
    </div>
    <div class="card card-pad" style="margin-top:16px">
      <h2>Wholesale Page Content</h2>
      <div class="field"><label>Wholesale Pitch & FAQs</label>
        <textarea class="input" name="wholesale_content" rows="12"><%= S.wholesale_content %></textarea>
        <div class="hint">Use HTML to format the text shown on /wholesale.</div></div>
    </div>
    <div class="card card-pad" style="margin-top:16px">
      <h2>Your admin login</h2>
      <div class="field"><label>Admin email</label><input class="input" name="admin_email" value="<%= admin.email %>"></div>
      <div class="field"><label>New password</label><input class="input" type="password" name="admin_password" minlength="8" placeholder="Leave blank to keep current">
        <div class="hint">At least 8 characters. Change this from the default before you go live.</div></div>
    </div>
    <button class="btn btn-block" style="margin-top:16px" type="submit">Save all settings</button>
  </div>
</div>
</form>
<%- include('admin/partials-bottom') %>
