<%- include('admin/partials-top',{title:'Customers',nav:'cust'}) %>
<div class="topbar"><div><h1>Customers</h1><p class="muted" style="margin:0"><%= pg.total %> accounts · <%= pendingUsers %> wholesale applications awaiting approval</p></div></div>
<form class="filters" method="get">
  <input class="input" name="q" placeholder="Name, email, company or phone" value="<%= query.q||'' %>">
  <select class="input" name="type"><option value="">Any type</option>
    <option value="retail" <%= query.type==='retail'?'selected':'' %>>Retail</option>
    <option value="wholesale" <%= query.type==='wholesale'?'selected':'' %>>Wholesale</option></select>
  <select class="input" name="status"><option value="">Any status</option>
    <% for(const s of ['active','pending','blocked']){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= s %></option><% } %></select>
  <button class="btn btn-sm" type="submit">Filter</button><a class="btn btn-sm btn-ghost" href="/admin/customers">Reset</a>
</form>
<div class="tablewrap"><table class="table">
  <thead><tr><th>Customer</th><th>Business</th><th>Contact</th><th>Type</th><th class="num">Orders</th><th class="num">Spend</th><th>Status</th><th></th></tr></thead>
  <tbody><% for(const u of users){ %><tr>
    <td><b><%= u.name %></b><br><span class="muted">Joined <%= fmtDate(u.created_at) %></span></td>
    <td><%= u.company || '—' %><% if(u.gstin){ %><br><span class="muted"><%= u.gstin %></span><% } %></td>
    <td><a href="https://wa.me/91<%= String(u.phone).replace(/\D/g,'').slice(-10) %>"><%= u.phone||'—' %></a><br><span class="muted"><%= u.email %></span></td>
    <td><span class="badge <%= u.account_type==='wholesale'?'badge-ok':'badge-muted' %>"><%= u.account_type %></span><% if(u.role==='admin'){ %><br><span class="badge">admin</span><% } %></td>
    <td class="num"><%= u.orders %></td>
    <td class="num"><b><%= money(u.spend||0) %></b></td>
    <td><span class="badge <%= u.status==='active'?'badge-ok':(u.status==='pending'?'badge-warn':'badge-bad') %>"><%= u.status %></span></td>
    <td style="white-space:nowrap; text-align:right">
      <% if(u.status!=='active'){ %><a class="btn btn-sm" href="/admin/customers/<%= u.id %>/status/active">Approve</a><% } %>
      <a class="btn btn-sm btn-ghost" href="/admin/customers/<%= u.id %>">Edit</a>
    </td></tr><% } %>
  <% if(!users.length){ %><tr><td colspan="8" class="empty">No customers match that filter.</td></tr><% } %>
  </tbody></table></div>
<% if(pg.pages>1){ %><div class="pager"><% for(let i=1;i<=pg.pages;i++){ %>
  <% if(i===pg.page){ %><span class="on"><%= i %></span><% } else { %><a href="<%= pageUrl(i) %>"><%= i %></a><% } %><% } %></div><% } %>
<%- include('admin/partials-bottom') %>
