<%- include('admin/partials-top',{title:'Pages',nav:'pages'}) %>
<div class="topbar"><div><h1>Content pages</h1><p class="muted" style="margin:0">About, policies and anything else static</p></div></div>
<div class="grid" style="grid-template-columns:280px 1fr;align-items:start">
  <div class="card card-pad">
    <h3>All pages</h3>
    <% for(const p of pages){ %>
      <a class="btn btn-block <%= editing && editing.id===p.id ? '' : 'btn-ghost' %>" style="margin-bottom:7px;justify-content:flex-start" href="/admin/pages?edit=<%= p.id %>"><%= p.title %></a>
    <% } %>
    <hr style="border:0;border-top:1px solid var(--line-2);margin:14px 0">
    <a class="btn btn-block btn-ghost" href="/admin/pages">+ New page</a>
  </div>
  <div class="card card-pad">
    <h2><%= editing ? 'Edit: '+editing.title : 'New page' %></h2>
    <form method="post" action="<%= editing ? '/admin/pages/'+editing.id : '/admin/pages/new' %>">
      <div class="row">
        <div class="field"><label>Title *</label><input class="input" name="title" required value="<%= editing?editing.title:'' %>" data-autoslug="#pslug"></div>
        <div class="field"><label>Slug *</label><input class="input" id="pslug" name="slug" required value="<%= editing?editing.slug:'' %>">
          <div class="hint">Appears as /pages/your-slug</div></div>
      </div>
      <div class="field"><label>Content (HTML)</label>
        <textarea class="input" name="body" style="min-height:420px;font-family:ui-monospace,Menlo,monospace;font-size:13px"><%= editing?editing.body:'' %></textarea>
        <div class="hint">Use &lt;h2&gt;, &lt;p&gt;, &lt;ul&gt;&lt;li&gt;, &lt;table&gt; and &lt;a href&gt;. Styling is applied automatically.</div></div>
      <label style="display:flex;gap:8px;align-items:center;margin-bottom:14px"><input type="checkbox" name="is_active" value="1" <%= !editing || editing.is_active?'checked':'' %>> Published</label>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" type="submit"><%= editing?'Save page':'Create page' %></button>
        <% if(editing){ %><a class="btn btn-ghost" href="/pages/<%= editing.slug %>" target="_blank">View on site</a>
          <a class="btn btn-danger" href="/admin/pages/<%= editing.id %>/delete" onclick="confirmDel(event,'Delete this page?')">Delete</a><% } %>
      </div>
    </form>
  </div>
</div>
<%- include('admin/partials-bottom') %>
