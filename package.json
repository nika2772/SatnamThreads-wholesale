{
  "name": "satnam-threads",
  "version": "1.0.0",
  "description": "Satnam Threads — retail ecommerce + B2B wholesale enquiry platform for garment accessories. Zero dependencies.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings server.js",
    "seed": "node --no-warnings src/seed.js && node --no-warnings src/gen-images.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && npm run seed",
    "images": "node --no-warnings src/gen-images.js",
    "preview": "node --no-warnings src/export-preview.js"
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
